{
  "name": "memory-lane",
  "version": "0.0.0",
  "private": true,
  "description": "Draw your neighbourhood's streets from memory, then see how close you got to the real map.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "calibrate": "vitest run --config vitest.calibrate.config.ts --reporter=verbose --silent=false"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2"
  }
}
